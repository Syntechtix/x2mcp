{
  "name": "mcpify",
  "version": "0.1.0",
  "description": "Create a native-language MCP server wrapper around any codebase",
  "keywords": ["mcp", "model-context-protocol", "codegen", "cli", "ai", "llm"],
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcpify": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "commander": "12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.11.1",
    "@types/node": "22.7.5",
    "eslint": "9.11.1",
    "prettier": "3.3.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.8.0",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
