<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>x2mcp</AssemblyName>
    <RootNamespace>X2Mcp.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>x2mcp</ToolCommandName>
    <PackageId>x2mcp</PackageId>
    <Authors>Syntechtix</Authors>
    <Description>Wraps existing source code as a Model Context Protocol (MCP) server, generated and built in the source's own native language.</Description>
    <RepositoryUrl>https://github.com/Syntechtix/x2mcp</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.1.0-beta</Version>
    <PackageReleaseNotes>Early beta — manually QA'd across all five supported languages but expect rough edges and breaking changes.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../X2Mcp.Core/X2Mcp.Core.csproj" />
    <ProjectReference Include="../X2Mcp.Language.DotNet/X2Mcp.Language.DotNet.csproj" />
    <ProjectReference Include="../X2Mcp.Language.Python/X2Mcp.Language.Python.csproj" />
    <ProjectReference Include="../X2Mcp.Language.Go/X2Mcp.Language.Go.csproj" />
    <ProjectReference Include="../X2Mcp.Language.Rust/X2Mcp.Language.Rust.csproj" />
    <ProjectReference Include="../X2Mcp.Language.Ruby/X2Mcp.Language.Ruby.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
