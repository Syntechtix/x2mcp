{
  "requiredExecutables": ["python", "pyinstaller"],
  "buildCommand": "-m PyInstaller --onefile --name {ServerName} {GeneratedProjectPath}/main.py",
  "publishCommand": "-m PyInstaller --onefile --name {ServerName} --distpath {OutputPath} {GeneratedProjectPath}/main.py",
  "supportedTransports": ["Stdio", "StreamableHttp"],
  "sourceExtensions": [".py"]
}
